{
  "name": "epub-reader-g2",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:serve & sleep 1 && npm run qr && wait",
    "dev:serve": "vite --host 0.0.0.0 --strictPort",
    "dev:sim": "npm run dev:serve & sleep 1 && evenhub-simulator http://localhost:5173/ && wait",
    "dev:serve:sim": "vite --host 0.0.0.0 --strictPort --open '/?simulator=true'",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "qr": "evenhub qr --port 5173 --path / -e",
    "qr:sim": "evenhub qr --port 5173 --path '/?simulator=true' -e",
    "init:evenhub": "evenhub init --output app.json",
    "pack": "npm run build && evenhub pack app.json ./dist --output epub-reader.ehpk",
    "pack:check": "evenhub pack app.json ./dist --check"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "@evenrealities/evenhub-cli": "^0.1.13",
    "even-toolkit": "^1.7.2",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.es": "^0.2.1",
    "hyphenation.fr": "^0.2.1",
    "hyphenation.nl": "^0.2.1",
    "hyphenation.pl": "^0.2.1",
    "hyphenation.pt": "^0.2.1",
    "hyphenation.ru": "^0.2.1",
    "hyphenation.uk": "^0.2.1",
    "hypher": "^0.2.5",
    "jszip": "^3.10.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.9"
  }
}
